{
  "mcpServers": {
    "qmd": {
      "command": "node",
      "args": [
        "C:\\Users\\omkar\\.bun\\install\\global\\node_modules\\@tobilu\\qmd\\dist\\cli\\qmd.js",
        "mcp"
      ]
    },
    "obsidian-brain": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\omkar\\OneDrive\\Documents\\Claude-Brain"
      ]
    },
    "github": {
      "command": "uvx",
      "args": ["mcp-server-github"],
      "env": {}
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@claude-flow/cli@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    },
    "pilot": {
      "command": "npx",
      "args": ["-y", "pilot-mcp"],
      "env": {
        "PILOT_BROWSER": "chromium"
      }
    },
    "notebooklm": {
      "command": "C:\\Users\\omkar\\OneDrive\\Desktop\\job-agent\\.venv\\Scripts\\python.exe",
      "args": ["C:\\Users\\omkar\\OneDrive\\Desktop\\job-agent\\tools\\notebooklm_mcp.py"],
      "env": {
        "NOTEBOOKLM_URL": "https://notebooklm.google.com"
      }
    }
  }
}
